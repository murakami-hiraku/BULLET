<%
const voiceData = [
  {
    starCount: 5,
    img: "p-voice-img-1.png",
    title: "ご家族の通院送迎",
    reason: "代車無料で安心",
    text: "母の通院に使っています。車検や税金込みで月額が明確なので助かります。故障時も代車を出してくれるので予定が狂わず安心です。",
    name: "60代 男性",
  },
  {
    starCount: 5,
    img: "p-voice-img-2.png",
    title: "デイサービス送迎",
    reason: "修理が早い",
    text: "送迎車両として3台リースしています。修理工場が母体なので、不具合があってもすぐに対応してもらえて助かっています。",
    name: "介護事業所 担当者様",
  },
  {
    starCount: 4,
    img: "p-voice-img-3.png",
    title: "リハビリ通所",
    reason: "短期契約できた",
    text: "退院後のリハビリ期間だけ利用したいと相談したら、6ヶ月の短期契約ができました。購入するより経済的で助かりました。",
    name: "50代 女性",
  },
];
%>



<section class="p-voice">
  <div class="p-voice__inner">
    <div class="p-voice__head">
      <h2 class="p-voice__title">
        ご利用者の声
      </h2>
    </div>
    <div class="p-voice__body">
      <div class="p-voice__cards">

        <%# ループ開始 %>
        <% voiceData.forEach((item) => { %>
        <div class="p-voice__card">
          <div class="p-voice__card-head">
            <img class="p-voice__card-img" src="/src/img/project/<%= item.img %>" alt="<%= item.name %>のイメージ画像">
          </div>

          <div class="p-voice__card-body">
            <div class="p-voice__card-inner">
              <div class="p-voice__card-stars" aria-label="評価: <%= item.starCount %> / 5">
                <% for (let i = 0; i < 5; i++) { %>
                <svg class="p-voice__card-star  <%= i < item.starCount ? 'is-active' : '' %>" viewBox="0 0 35 34" aria-hidden="true">
                  <path xmlns="http://www.w3.org/2000/svg" d="M16.7113 1.3245C16.7843 1.17693 16.8971 1.05272 17.037 0.965873C17.1769 0.879027 17.3383 0.833008 17.5029 0.833008C17.6676 0.833008 17.8289 0.879027 17.9688 0.965873C18.1087 1.05272 18.2215 1.17693 18.2946 1.3245L22.1446 9.12283C22.3982 9.63611 22.7726 10.0802 23.2356 10.4169C23.6986 10.7537 24.2365 10.973 24.8029 11.0562L33.4129 12.3162C33.5761 12.3398 33.7293 12.4086 33.8554 12.5148C33.9815 12.621 34.0753 12.7604 34.1263 12.9172C34.1773 13.0739 34.1834 13.2418 34.1439 13.4019C34.1044 13.5619 34.021 13.7078 33.9029 13.8228L27.6763 19.8862C27.2656 20.2863 26.9584 20.7803 26.781 21.3255C26.6036 21.8708 26.5614 22.451 26.6579 23.0162L28.1279 31.5828C28.1567 31.7459 28.1391 31.9138 28.0771 32.0673C28.0151 32.2208 27.9111 32.3538 27.7772 32.4512C27.6432 32.5485 27.4846 32.6062 27.3194 32.6177C27.1542 32.6292 26.9891 32.594 26.8429 32.5162L19.1463 28.4695C18.6391 28.2032 18.0749 28.0641 17.5021 28.0641C16.9293 28.0641 16.3651 28.2032 15.8579 28.4695L8.16292 32.5162C8.0168 32.5935 7.85191 32.6283 7.687 32.6166C7.52209 32.6049 7.36378 32.5471 7.23008 32.4499C7.09637 32.3526 6.99264 32.2198 6.93068 32.0665C6.86872 31.9133 6.85102 31.7457 6.87958 31.5828L8.34792 23.0178C8.44491 22.4524 8.40289 21.8718 8.22548 21.3262C8.04807 20.7807 7.7406 20.2864 7.32958 19.8862L1.10292 13.8245C0.983908 13.7096 0.899573 13.5635 0.859522 13.403C0.819471 13.2424 0.825313 13.0739 0.876383 12.9165C0.927452 12.7591 1.0217 12.6192 1.14838 12.5128C1.27506 12.4064 1.42909 12.3377 1.59292 12.3145L10.2013 11.0562C10.7683 10.9737 11.3069 10.7546 11.7706 10.4178C12.2342 10.081 12.6091 9.63661 12.8629 9.12283L16.7113 1.3245Z" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <% } %>
              </div>
              <h3 class="p-voice__card-title">
                <%= item.title %>
              </h3>
            </div>

            <div class="p-voice__card-container">
              <p class="p-voice__card-reason">選ばれた理由：<%= item.reason %></p>
              <div class="p-voice__card-text">
                <p>「<%= item.text %>」</p>
                <small class="p-voice__card-name"><%= item.name %></small>
              </div>
            </div>
          </div>
        </div>
        <% }); %>
        <%# ループ終了 %>

      </div>
    </div>
  </div>
</section>